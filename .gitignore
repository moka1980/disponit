# Generert av run_synthetic.py — M-2-logg er kjøreartefakt, ikke kilde
platform/core/examples/audit.jsonl

# Windows
Thumbs.db
desktop.ini

# Draft-pakker fra claude.ai hoerer ikke hjemme i repoet.
# De sikres av ~/tools/disponit_backup.sh fra Downloads-mappen.
*.zip

# Lasttest-artefakter (perf-m01-v1). Ad hoc-kjøringer holdes ute av
# historikken: en JSON fra en tilfeldig utviklermaskin ser ut som et bevis
# uten å være det.
deploy/staging/artefakter/*.json

# UNNTAK: artefaktet et manifest FAKTISK peker på må ligge i repoet.
# Codex' P1 på PR #8: en sti uten fil er ingen evidenskjede, og en sha256
# uten filen er bare beviset på at noen kjenner en streng. Bekymringen over
# løses ikke av å utestenge filen, men av `manifestskjema.valider_artefakter`,
# som åpner den, verifiserer hashen og måler tallene mot KRAVGRENSER — da
# hjelper det ikke å legge inn en oppdiktet JSON.
!deploy/staging/artefakter/perf-m01-v1-maal-20260802T205915.json
!deploy/staging/artefakter/feilinjisering-m01-v1-20260805T074109.json
!deploy/staging/artefakter/rollback-m01-v1-20260805T081921.json
# PR-012: deploy-verifisert menneskelig-behandling-artefakt (onecom-staging).
!deploy/staging/artefakter/behandling-m37-v1-20260810T172407.json
# 049 (m56-akseptflippen): runde-sammendraget, flippedrillen og råfilen
# de avledes av — manifestet sha256-binder sammendraget, sammendraget
# binder råfilen (kilde_sha256), og CI regenererer og sammenligner.
