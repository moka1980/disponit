# PR-009b — HTTPS (443). Steg 3 i ACME-tilstandsmaskinen: legges til FØRST
# etter at sertifikatet finnes. `${DISPONIT_HOST}` rendres av
# opp-transport.sh. HTTP-blokken (redirect + ACME) beholdes fra
# disponit-http.conf.

# Ukjent SNI → handshake avvises (v3 §3): klienten stopper på
# sertifikatfeil og ser ALDRI en HTTP-respons. Ingen upstream, ingen
# tenant-lekkasje via feil vert.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    ssl_reject_handshake on;
    # Kjent SNI (håndtrykk fullført mot den ekte verten) MEN en Host-header
    # som ikke matcher noe server_name rutes hit av Host-utvelgelsen. Da er
    # håndtrykket alt gjort, og svaret skal være 421 (v2 §1), ikke nginx'
    # default 404. Ukjent SNI stoppes fortsatt i håndtrykket over.
    return 421;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DISPONIT_HOST};
    server_tokens off;

    # --- TLS (v2 §6 / v3 §4): TLS 1.2+1.3 KUN, eksplisitte ciphers -------
    ssl_certificate     /etc/letsencrypt/live/${DISPONIT_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DISPONIT_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_conf_command Ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256;
    ssl_ecdh_curve X25519:prime256v1;
    ssl_session_cache shared:disponit_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # AVVIK fra v1 §2 «OCSP stapling on», flagget: Let's Encrypt RETIRERTE
    # OCSP i 2025 — sertifikatene har ingen responder-URL å staple, og
    # `ssl_stapling on` er da en no-op som bare logger en advarsel ved hver
    # reload (målt på disponit.com). Utelatt bevisst; revurderes hvis
    # sertifikatutstederen får OCSP igjen.

    # --- Grenser (v1 §5) ------------------------------------------------
    # Server-vid grense = app-lagets 256 KiB som andre linje. Artefakt-ruten
    # har sin EGEN, større grense i `location = /v1/artefakt` under; uten den
    # ville nginx svart 413 lenge før appens rutegrense ble nådd.
    client_max_body_size 256k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 65s;

    # --- Logg: hovedformat uten query (v2 §5) ---------------------------
    access_log /var/log/nginx/disponit-access.log disponit_main;
    error_log  /var/log/nginx/disponit-error.log warn;

    # --- Responsheadere (v1 §4). HSTS er BEVISST utelatt (v2 §6:
    #     separat auditert aktiveringsport etter stabil TLS). ------------
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    # API-CSP nå (v2 §6): API svarer JSON, ingen ressurser. UI-ets CSP
    # kommer i UI-leveransen — en global CSP skrevet før UI-ressursene er
    # kjent ville blokkert den godkjente UI-leveransen.
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;

    # --- Host = SNI (v2 §1): server_name gated SNI; her gates Host. En
    #     request som nådde denne blokken med avvikende Host → 421,
    #     aldri upstream. ---------------------------------------------------
    if ($host != ${DISPONIT_HOST}) {
        return 421;
    }

    # --- Proxy-hygiene (v2 §2 + §4) -------------------------------------
    proxy_http_version 1.1;
    # Hop-by-hop mot upstream fjernes; ingen websocket-oppgradering.
    proxy_set_header Connection "";
    proxy_set_header Upgrade "";
    # TLS-beviset er HARDKODET fra proxyen (ikke $scheme): API-et er bak
    # denne, og alt som når socketen kom gjennom her.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host ${DISPONIT_HOST};
    # Kanonisk host (v2 §1) — PR-010 utleder workspace fra DENNE, aldri fra
    # rå Host. proxy_set_header ERSTATTER enhver klientsendt verdi.
    proxy_set_header X-Disponit-Host ${DISPONIT_HOST};
    proxy_set_header Host $host;
    # Klientsendte infrastruktur-varianter nulles eksplisitt (v2 §2).
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";

    # OIDC-rutene: KUN sin egen sone (klarsignal V3) — den generelle
    # gjelder dem aldri. Callback har i tillegg redigert access-logg.
    location = /v1/oidc/callback {
        access_log /var/log/nginx/disponit-callback.log disponit_callback;
        error_log  /var/log/nginx/disponit-callback-error.log crit;
        limit_req zone=disponit_oidc burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/disponit/api.sock;
    }
    location = /v1/oidc/start {
        limit_req zone=disponit_oidc burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/disponit/api.sock;
    }

    # PR-014b §7: artefaktopplastingen er den ENESTE ruten som bærer mer enn
    # 256 KiB. Codex: uten en egen proxy-grense her avviste nginx enhver wire-
    # kropp over 256 KiB med 413 FØR appens rutegrense (`MAKS_ARTEFAKT_KROPP`)
    # i det hele tatt ble konsultert — altså var 1 MiB-artefaktet ruten er
    # bygget for uoppnåelig i den eneste stien en kontroller faktisk har.
    # Verdien er BUNDET til appkonstanten av
    # `test_nginx_artefaktrute_slipper_gjennom_appens_kroppsgrense`, så de to
    # tallene ikke kan gli fra hverandre.
    location = /v1/artefakt {
        client_max_body_size 6208k;     # = MAKS_ARTEFAKT_KROPP (6 MiB + 64 KiB)
        limit_req zone=disponit_general burst=100 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/disponit/api.sock;
    }

    # #162: inndata-opplastingen — samme klasse som artefaktruten over, men
    # to størrelsesordener større, og med en jti i STIEN.
    #
    # Codex P1: kontrakten reserverer og annonserer 64 MiB
    # (`INNDATA_MAKS_FYSISK`), men uten denne blokken traff ruten den
    # server-vide `client_max_body_size 256k` — nginx hadde svart 413 på
    # hver eneste bunt over 256 KiB, altså på alle bunter ruten finnes for,
    # lenge før appens egen strømmetelling så en byte. Prefiks-location og
    # ikke `=`, fordi stien bærer `{jti}`.
    #
    # Codex P2: `disponit_main` logger `$uri`, og `$uri` ER jti-en her.
    # Hver utstedte engangsreservasjon ville dermed stått i klartekst i
    # `disponit-access.log`; den som kunne lese loggen og hadde en
    # tenant-sesjon med `bestilling:opprett` kunne forbruke en utestående
    # reservasjon før klienten den ble utstedt til. Samme grep som
    # callback-redaksjonen (v2 §5): ruten får et eget log_format der stien
    # er en KONSTANT etikett, ikke en variabel.
    #
    # Codex P2 (runde 5): redaksjonen over tok bare `access_log`. Ruten
    # arvet serverens `error_log ... warn`, og nginx' egen 413-linje
    # («client intended to send too large body») skrives på `error`-nivå
    # MED hele request-linja — altså jti-en, i klartekst, i den delte
    # `disponit-error.log`. Verre enn access-lekkasjen: den utløses av en
    # forespørsel som ble AVVIST, så reservasjonen er fortsatt ubrukt når
    # den lander i loggen. Samme grep som callbacken (v2 §5): egen fil og
    # `crit`, som ligger OVER `error` og dermed ikke skriver linja i det
    # hele tatt.
    #
    # Codex P1 (runde 5): «auth først, kropp etterpå» i `opplast_endepunkt`
    # gjelder BARE appen så lenge ingressen bufrer. Med nginx' default
    # `proxy_request_buffering on` leses hele kroppen inn før noe sendes
    # oppstrøms, så en klient uten gyldig sesjon får proxyen til å ta imot
    # inntil 64 MiB per forespørsel — burst 100 i sonen — før API-et i det
    # hele tatt får sjansen til å svare 401. Da er det nginx' temp-lager og
    # I/O som er flaten, ikke API-prosessen fiksen i runde 1 vernet. Av
    # samme grunn som den fiksen: uten bufring strømmer kroppen rett til
    # socketen, og 401-en kommer mens klienten fortsatt sender.
    #
    # Begge tallene og redaksjonen er bundet til appen av
    # `test_nginx_inndataruten_slipper_bunten_gjennom_og_redigerer_jtien`.
    location /v1/inndata/opplast/ {
        client_max_body_size 65536k;    # = INNDATA_MAKS_FYSISK (64 MiB)
        proxy_request_buffering off;
        access_log /var/log/nginx/disponit-access.log disponit_opplast;
        error_log  /var/log/nginx/disponit-opplast-error.log crit;
        limit_req zone=disponit_general burst=100 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/disponit/api.sock;
    }

    # PR-011: M-1 kundeflate. UI-svar trenger en ÅPNERE CSP enn API-ets
    # `default-src 'none'` (klarsignal V4) — den ville ellers blokkert egne
    # ressurser. Appen setter UI-CSP-en selv (målbar i CI, gate 5); her
    # skjuler vi den oppstrøms og re-setter den, så UI-svaret bærer NØYAKTIG
    # én CSP og API-ets strenge CSP aldri lekker inn på UI-stiene. De øvrige
    # sikkerhetsheaderne (Referrer/XCTO/XFO) kommer uendret fra appen.
    location = / {
        limit_req zone=disponit_general burst=100 nodelay;
        limit_req_status 429;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' ${DISPONIT_UI_IDP_ORIGINS}; manifest-src 'self'; upgrade-insecure-requests" always;
        proxy_pass http://unix:/run/disponit/api.sock;
    }
    location /ui/ {
        limit_req zone=disponit_general burst=100 nodelay;
        limit_req_status 429;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' ${DISPONIT_UI_IDP_ORIGINS}; manifest-src 'self'; upgrade-insecure-requests" always;
        proxy_pass http://unix:/run/disponit/api.sock;
    }

    location / {
        limit_req zone=disponit_general burst=100 nodelay;
        limit_req_status 429;
        # Tillitsgrensen (PR-009b §0): Unix-socket, aldri TCP. Gruppen
        # disponit-proxy gir nginx-brukeren tilgang; ingen annen lokal
        # prosess når den.
        proxy_pass http://unix:/run/disponit/api.sock;
    }
}
