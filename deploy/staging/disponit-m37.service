# M-37 behandlingsmotor — EGEN PROSESS, aldri i API-prosessen.
#
# PR-006 §0: ytelsesporten perf-m01-v1 er målt med 3,4× spredning
# (p95 24–82 ms) og p99 207 ms, og verste kjøring brukte 55 % av budsjettet.
# Legges M-37-arbeid inn i forespørselsveien, spises nøyaktig den marginen.
# Derfor en egen unit, og derfor en statisk sjekk i testsuiten på at
# `api/` aldri importerer `m37/`.
#
# PR-009 v2 §3: egen Unix-bruker, egne credentials — et kompromittert API
# får ikke arbeiderens fullmakter, og omvendt. v3 §1: hovedløkken skriver
# atomisk heartbeat til RuntimeDirectory; disponit-helse.timer leser den.
#
# Installeres av opp.sh — aldri for hånd.

[Unit]
Description=Disponit M-37 behandlingsmotor (unntakskøen)
# API-et bør være oppe (arbeideren ber om beslutninger gjennom det), men
# ingen Requires: de skal kunne restartes uavhengig, og claim-leasen tåler
# at API-et er borte et øyeblikk.
After=network-online.target postgresql.service disponit-api.service
Wants=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=disponit-m37
Group=disponit-m37
WorkingDirectory=/opt/disponit/platform/core
RuntimeDirectory=disponit-m37
RuntimeDirectoryMode=0755

LoadCredential=DATABASE_URL:/etc/disponit/m37/DATABASE_URL
LoadCredential=DISPONIT_KEK:/etc/disponit/m37/DISPONIT_KEK
# DISPONIT_API_URL settes i konfigfilen — og med PR-009b finnes INGEN
# TCP-port: arbeiderens fase-2-kall går gjennom nginx over HTTPS, som
# enhver annen klient. API-socketen er eksplisitt UTILGJENGELIG for denne
# brukeren (tillitsgrensen, målt med EACCES-porten). Frem til PR-009b er
# merget kan fase 2 derfor ikke fullføre — claim, heartbeat og restart
# måles; det er PR-009s ærlige omfang.
EnvironmentFile=-/etc/disponit/m37/konfig

ExecStart=/opt/disponit/.venv/bin/python -m m37.arbeider

# Restart=always (v2 §2): arbeideren skal ALLTID tilbake — claim-leasen
# tåler krasj og re-claim, og en ren exit (kode 0) er også en stopp den
# skal reise seg fra. StartLimit sørger for at en permanent
# feilkonfigurasjon ender i tydelig `failed`, ikke uendelig støy.
Restart=always
RestartSec=5

# Herding. Arbeideren trenger nettverk til loopback-API-et og en
# databasetilkobling — ingenting annet.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Dekryptert payload skal ALDRI til disk. Kjernedump ville skrevet den dit.
LimitCORE=0

[Install]
WantedBy=multi-user.target
