# M-14 (106): én gang i døgnet.
#
# Kadensen og regelen hører sammen: både `kontrollfrist_dogn` og
# `dublettvindu_dogn` måles i DØGN, og en faktura blir ikke ukontrollert
# midt på dagen.
#
# SVEIPEN GODKJENNER INGEN FAKTURA. Den kunne — den vet hvilke som er
# kontrollert uten avvik — men en godkjenning er fullmakten som slipper
# en automatisk bokføring gjennom, og den tas ikke av en nattjobb.
#
# KLOKKESLETTET ER 06:20 fordi 03:15, 04:20, 04:35, 04:50, 05:05, 05:20,
# 05:35, 05:50 og 06:05 alt er tatt. Sveipens første steg leser ALLE
# tenanters fakturaer, og to slike skann på samme sekund legger seg oppå
# hverandres I/O uten grunn.
#
# `RandomizedDelaySec=30min` og `Persistent=true`: samme begrunnelse som
# nabosveipene. Sveipen måler NÅ («hva står ukontrollert i dag»), ikke da.

[Unit]
Description=Disponit fakturasveip-timer

[Timer]
OnCalendar=*-*-* 06:20:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
