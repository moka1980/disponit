# M-49 (117): sanksjonssveipen for uavklarte treff og gamle
# kontroller.
#
# Sveipen legger INGEN logikk oppå regelen. Regelen eies av databasen
# (117): et treff ingen har avklart innen tenantens frist er
# `uavklart_treff`; et subjekt ingen har kontrollert er
# `ukontrollert_subjekt`; en kontroll eldre enn gyldighetsvinduet er
# `kontroll_utlopt`; en kontroll mot en listeversjon som ikke lenger
# er den nyeste er `kontroll_mot_gammel_liste`; et treff et menneske
# har bekreftet er `bekreftet_treff`; og en tenant uten policy eller
# uten listeversjon er `ingen_krav` eller `ingen_liste`.
#
# SVEIPEN AVKLARER INGENTING, OG DET ER MODULENS VIKTIGSTE FRAVÆR.
# Den ser hvert eneste uavklarte treff og vet likheten på hvert av
# dem. Å lukke alle under 90 % ville tømt køen på én natt — og vært
# nøyaktig det spesifikasjonen forbyr: «navnelikhet er aldri
# automatisk avfeid». Feilen ville dessuten vært usynlig, fordi en kø
# som går ned ser ut som saksbehandling.
#
# SVEIPEN BLOKKERER HELLER INGENTING. v1 blokkerer ikke; beslutningen,
# motargumentet og utløseren står i toppen av migrasjon 117.
#
# DERFOR ER `RestrictAddressFamilies` HER ET GJERDE OG IKKE EN
# FORMALITET. Den slipper AF_INET fordi DATABASEN nås over TCP — ikke
# fordi noe skal ut til en sanksjonsliste. Listene registreres av et
# menneske som har lastet dem ned, med kilde, versjon og innholdssum;
# gjerdet mot automatisk nedlasting står i koden
# (`sanksjonssveip.py` importerer ingenting som kan snakke ut) og i
# porten som måler det.
#
# ETT FUNN, IKKE ETT PER DØGN. Idempotensen bor i basen.
#
# TO SAMMENHENGENDE FEILEDE KJØRINGER → ALARM. En stille
# sanksjonssveip er uavklarte treff ingen har sett på.
#
# ROLLEN ER JOBBENS EGEN. `disponit_sanksjonssveip` har nøyaktig ÉN
# rettighet: EXECUTE på `m49_sveip_sanksjoner`. INGEN
# tabellrettigheter.
#
# UNIX-IDENTITETEN ER DRIFTSTIMERNES, `disponit-domener`.

[Unit]
Description=Disponit sanksjonssveip (uavklarte treff og gamle kontroller -> funn)

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
# Se disponit-domenerevalidering.service: `drift` (platform/) og `db`
# (platform/core/db) er søskenpakker, ikke nøstet — releaseroten alene
# eksponerer ingen av dem.
WorkingDirectory=/opt/disponit/aktiv/platform
Environment=PYTHONPATH=/opt/disponit/aktiv/platform/core
# Feiltelleren lever i en fil fordi hver kjøring er en egen prosess
# (`Type=oneshot`): «to feilede kjøringer på rad» kan ikke observeres av
# kjøringen selv. `StateDirectory` lar systemd opprette katalogen med
# riktig eier FØR ExecStart og oppgir den i $STATE_DIRECTORY. Samme
# katalog og samme eier som de andre sveipene — de deler Unix-identitet,
# så et eget navn ville bare gitt enda en katalog med samme rettigheter.
StateDirectory=disponit
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
CapabilityBoundingSet=
AmbientCapabilities=
LoadCredential=DISPONIT_SANKSJONSSVEIP_URL:/etc/disponit/sanksjonssveip/DISPONIT_SANKSJONSSVEIP_URL
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_sanksjonssveip
# Sveipen er ETT funksjonskall som gjør to setninger per tenant, begge
# indeksdekket (`sanksjonssubjekt_aktive`,
# `sanksjonskontroll_oppslag`, `sanksjonstreff_kontroll`,
# `sanksjonsfunn_apne`). Går dette over ti
# minutter, henger noe — og da er avbrudd riktig svar: funnene er
# idempotente, så neste døgn tar kjøringen igjen.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
