# 039: førstegangsverifisering av selvbetjente domenechallenges.
#
# Kunden utstedte challengen fra flaten og la TXT-verdien i sonen sin;
# dette passet finner beviset (≥2 enige, uavhengige resolvere — samme
# diversitetskrav som revalideringen) og lar DATABASEN holde det mot
# hashen (`bekreft_domenechallenge`). Rollen er `disponit_domener` —
# EXECUTE på nøyaktig plukk- og bekreftelsesfunksjonen, ingen
# bordtilgang, aldri `verifiser_domenekontroll` direkte.

[Unit]
Description=Disponit domeneverifisering (selvbetjente challenges)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
WorkingDirectory=/opt/disponit/aktiv/platform
Environment=PYTHONPATH=/opt/disponit/aktiv/platform/core
LoadCredential=DISPONIT_DOMAINS_URL:/etc/disponit/domener/DISPONIT_DOMAINS_URL
LoadCredential=DISPONIT_RESOLVERE:/etc/disponit/domener/DISPONIT_RESOLVERE
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_domeneverifisering
# FRISTEN ER PASSETS, IKKE SYSTEMDS (Codex P2) — samme skille som
# varselsenderen. Passet var SERIELT med et tak i ANTALL (200 hostnames), og de
# to hang ikke sammen: 200 navn à ~10 s resolverlevetid er opptil 2000 s mot en
# unit som dør etter 240. En kohort med trege navn foran i
# `challenge_utstedt`-rekkefølgen spiste hele vinduet, neste kjøring plukket de
# SAMME radene, og kundene bak dem ble sultet til utfordringen utløp.
#
# Nå kjøres oppslagene med samtidighet 8 og konsumeres i FULLFØRINGSrekkefølge
# (de friske først), taket er utledet til 100 (~130 s verste tilfelle), og
# passet stanser seg selv etter `VERIFISERING_FRIST_S` = 3 min — mellom to
# ferdige oppslag, det ene punktet der ingenting er halvveis skrevet. Resten av
# køen står `ventende` og tas av neste timerkjøring om fem minutter.
#
# TimeoutStartSec er dermed et SIKKERHETSNETT som ikke skal utløses: fristen
# (3 min) + den ene bekreftelsen som kan være påbegynt når fristen slår inn +
# margin. Tallene hører sammen og skal endres sammen.
TimeoutStartSec=4min

[Install]
WantedBy=multi-user.target
