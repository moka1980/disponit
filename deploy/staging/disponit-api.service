# Disponit API — socket-aktivert uvicorn (PR-009 v1 §1 + v2 §2–3,
# ENDRET av PR-009b §0: INGEN TCP-port, noensinne).
#
# API-et lytter KUN på Unix-socketen fra disponit-api.socket
# (/run/disponit/api.sock, gruppe disponit-proxy). systemd leverer den som
# fd 3 (SD_LISTEN_FDS_START); uvicorn overtar med `fd=3`. `/ready`-polling
# i opp.sh skjer med `curl --unix-socket` — som root, ikke som et
# gruppemedlem, så pollingen aldri blir en grunn til å utvide gruppen.
#
# Boot-sjekken `krev_lovlig_bind` står urørt: Tjeneste-verten er fortsatt
# loopback (rate-grensens prosesslokale premiss), og socketen er strengere
# enn loopback — den har en EIER.
#
# `Type=simple`, IKKE `notify`: prosessen implementerer ikke sd_notify, og
# å påstå det ville vært en port vi ikke kan måle. Restart-på-hengning er
# disponit-helse.timer mot /live over socketen.
#
# Installeres av opp.sh — aldri for hånd.

[Unit]
Description=Disponit M-1 API (Unix-socket, aldri TCP)
Requires=disponit-api.socket
After=network-online.target postgresql.service disponit-api.socket
Wants=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=disponit-api
Group=disponit-api
WorkingDirectory=/opt/disponit/aktiv/platform/core

# Hemmeligheter via systemd-credentials (v3 §5) — root-eide filer under
# /etc/disponit/api/, synlige KUN for denne unitens $CREDENTIALS_DIRECTORY.
# Et kompromittert API kan ikke lese arbeiderens credential-filer.
LoadCredential=DATABASE_URL:/etc/disponit/api/DATABASE_URL
LoadCredential=DISPONIT_KEK:/etc/disponit/api/DISPONIT_KEK
LoadCredential=DISPONIT_TOKEN_PEPPER:/etc/disponit/api/DISPONIT_TOKEN_PEPPER
LoadCredential=DISPONIT_ATT_NOKLER:/etc/disponit/api/DISPONIT_ATT_NOKLER
# PR-012: MAC-register (oppstartsperre) for menneskelig unntaksbehandling.
LoadCredential=DISPONIT_MAC_NOKLER:/etc/disponit/api/DISPONIT_MAC_NOKLER
# PR-013: miljøsignaturen (tzdata) releasen ble bygget med — boot fail-closer
# ved avvik (V8, port 13).
LoadCredential=DISPONIT_SEMANTIKK_MILJO:/etc/disponit/api/DISPONIT_SEMANTIKK_MILJO
# PR-011b: UI-provider + IdP-origins (deploy-config, ikke hemmeligheter, men
# samme LoadCredential-hydrering til os.environ). Tomme filer = trygg default.
LoadCredential=DISPONIT_UI_PROVIDER:/etc/disponit/api/DISPONIT_UI_PROVIDER
LoadCredential=DISPONIT_UI_IDP_ORIGINS:/etc/disponit/api/DISPONIT_UI_IDP_ORIGINS
# M-6 (PR-B): M365-kildekoblingen. Tomme filer = trygg default, som
# UI-variablene over: `lag_konfig()` returnerer None og /start svarer 503
# «ikke konfigurert». Hemmeligheten er en ekte hemmelighet og går derfor
# gjennom LoadCredential som de andre — aldri gjennom en EnvironmentFile
# hele prosesstreet kan lese.
LoadCredential=DISPONIT_M365_CLIENT_ID:/etc/disponit/api/DISPONIT_M365_CLIENT_ID
LoadCredential=DISPONIT_M365_CLIENT_SECRET:/etc/disponit/api/DISPONIT_M365_CLIENT_SECRET
LoadCredential=DISPONIT_M365_REDIRECT_URI:/etc/disponit/api/DISPONIT_M365_REDIRECT_URI
LoadCredential=DISPONIT_M365_TENANT:/etc/disponit/api/DISPONIT_M365_TENANT
LoadCredential=DISPONIT_M365_ALLOWLIST:/etc/disponit/api/DISPONIT_M365_ALLOWLIST
# PR-045: miljøet prosessen kjører i (`platform/core/miljo`). Ikke en
# hemmelighet, men samme hydreringsvei — og uten den nådde verdien aldri
# prosessen: `lag_app()` leser kun det unitten laster, så både
# policyregisterets statusregel og `/ui/oppsett.json` tok fallbacken uansett
# hva miljøfila sa. Filen skrives av opp.sh, som avviser alt annet enn
# `staging` på denne maskinen.
LoadCredential=DISPONIT_MILJO:/etc/disponit/api/DISPONIT_MILJO

# access_log=False: uvicorns ASGI-access-logg skriver hele request-linjen
# — inkludert en callback-query — til journald. Det er den FEMTE logglag-
# lekkasjen PR-009b v2 §5 forbyr (målt: query nådde journald før dette).
# nginx er access-loggen av record (redigert), og appens egen Sikkerhetslogg
# er strukturert uten payload/query. ASGI-access-loggen er ren duplikat +
# lekkasjevektor, og slås av.
ExecStart=/opt/disponit/.venv/bin/python -c 'import uvicorn; \
from api.app import lag_app; \
uvicorn.run(lag_app(), fd=3, log_level="info", access_log=False)'

Restart=on-failure
RestartSec=5

# Delt vert (DEPLOY.md: samlokalisert med annet produkt) => per-unit
# loggbrems, aldri global journald-omskriving (v2 §7).
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000

# Herding (v1 §1).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# #162: den ENESTE skrivbare stien under `strict`. Uten den gjør
# `ProtectSystem=strict` hele hierarkiet utenom API-filsystemene read-only
# (systemd.exec(5)), og `os.makedirs`/`open` i inndata-veien feiler med
# EROFS — hver eneste opplasting hadde blitt en intern feil i prod, mens
# `install -d` i opp.sh og eierskapet så helt riktig ut.
#
# EGEN state-katalog, ikke en gren under /var/lib/disponit (Codex P1,
# andre runde på samme linje). Første forsøk var
# `ReadWritePaths=/var/lib/disponit/inndata`. Det løser read-only, men ikke
# UNIX-TRAVERSERING: /var/lib/disponit er `disponit-artefaktrydding.service`
# sin StateDirectory, som systemd holder på `disponit-domener:0750` ved hver
# start av den uniten. Denne prosessen er `disponit-api` og står verken som
# eier eller i gruppa, så `open()` på et barn ville gitt EACCES på veien
# NED — og `install -d -m 700 -o disponit-api` i opp.sh går motsatt vei: på
# en fersk vert oppretter GNU install også den manglende FORELDEREN med de
# oppgitte attributtene, og da er det ryddeuniten som mister katalogen sin.
# To units som eier hvert sitt eierskap på samme tre drar den fram og
# tilbake uansett hvilken vei man løser det.
#
# `StateDirectory=` fjerner hele kollisjonen: systemd oppretter
# /var/lib/disponit-inndata som User=/Group= ved HVER start, gjør den
# skrivbar under `strict` uten en egen ReadWritePaths-linje, og ingen annen
# unit rører treet. 0700 fordi payloaden er tenant-DEK-kryptert og ingen
# annen bruker har noe der å gjøre.
StateDirectory=disponit-inndata
StateDirectoryMode=0700
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Dekryptert innhold skal aldri til disk — heller ikke som kjernedump.
LimitCORE=0

[Install]
WantedBy=multi-user.target
