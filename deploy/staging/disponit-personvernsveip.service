# M-30 (099): fristsveipen over forespørselsregisteret.
#
# Sveipen legger INGEN logikk oppå regelen. Regelen eies av databasen:
# `m30_sveip_frister(7)` reiser ETT funn per (sak, funntype) for åpne
# saker forbi sin gjeldende frist (`frist_oversittet`), innenfor
# varselvinduet (`frist_naermer_seg`) eller uten et eneste av M-4s
# lagre (`sak_uten_lagre`), oppdaterer `sist_sett_sveip` på dem som alt
# finnes, og lukker dem som ikke lenger gjelder. Sveipen bestemmer ikke
# hva som er oversittet — den kaller funksjonen som vet det.
#
# DEN VIKTIGSTE EGENSKAPEN ER EN FRAVÆRENDE: SVEIPEN SLETTER
# INGENTING, og den setter aldri en sakstatus. Sletting eies av M-4s
# retensjonsregnskap (093) og de seks reaperne som kjører; en ANDRE
# slettevei ved siden av dem er nøyaktig det M-4 ble bygget for å
# hindre, og to veier som sletter det samme kan aldri holdes i takt. Og
# en frist som passerer lukker ingen sak: en oversittet
# innsynsforespørsel er et LOVBRUDD, ikke en forsinkelse. Den skal bli
# et funn noen ser, ikke en rad som stille blir «ferdig».
#
# ETT FUNN, IKKE ETT PER DØGN. Idempotensen bor i basen, ikke her: en
# daglig sveip over en sak som har vært oversittet i et halvt år gir ETT
# funn, ikke 180. En funnliste som vokser med kadensen er en funnliste
# folk lærer seg å overse — og da forsvinner de viktige med dem.
#
# TO SAMMENHENGENDE FEILEDE KJØRINGER → ALARM. En stille fristsveip er
# et register som eldes uten at noen ser det, altså nøyaktig tilstanden
# modulen finnes for å gjøre synlig.
#
# ROLLEN ER JOBBENS EGEN. `disponit_personvernsveip` har nøyaktig ÉN
# rettighet i basen: EXECUTE på `m30_sveip_frister`. INGEN
# tabellrettigheter, ingen lesedør, ingen skrivedør, ingen kunderad —
# funnene skrives av den eier-eide defineren, aldri av rollen direkte.
# Delte den DSN med runtime, ville sveipen måttet grantes til
# `disponit`; sveipen er KRYSS-TENANT og setter selv RLS-konteksten, så
# det ville gitt hele forespørselsveien nøyaktig det vinduet denne
# rollen finnes for å nekte den. 099 REVOKEr den derfor eksplisitt fra
# `disponit` — en rettighet som bare slutter å bli gitt er ikke trukket
# tilbake. Innsnevringen betyr i praksis at sveipen kan reise funn i
# alle tenanter uten å kunne LESE en eneste forespørsel selv, og det er
# ikke pedanteri: et register over hvem som har krevd innsyn i sine egne
# personopplysninger er husets mest sensitive lager.
#
# UNIX-IDENTITETEN ER DRIFTSTIMERNES, `disponit-domener` — den samme
# `disponit-artefaktrydding`, `disponit-evidensreaper`,
# `disponit-domenerevalidering` og `disponit-begrepssveip` har, og av
# samme grunn: dette er en ren driftstimer uten filsystemfullmakter.
# Autoriteten ligger IKKE i Unix-brukeren; den ligger i DB-rollen over,
# som er sveipens egen og ingen annens. En ny Unix-identitet ville
# flyttet null autoritet og lagt én identitet til å forvalte.

[Unit]
Description=Disponit personvernsveip (frister -> personvernfunn)

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
# Se disponit-domenerevalidering.service: `drift` (platform/) og `db`
# (platform/core/db) er søskenpakker, ikke nøstet — releaseroten alene
# eksponerer ingen av dem.
WorkingDirectory=/opt/disponit/aktiv/platform
Environment=PYTHONPATH=/opt/disponit/aktiv/platform/core
# Feiltelleren lever i en fil fordi hver kjøring er en egen prosess
# (`Type=oneshot`): «to feilede kjøringer på rad» kan ikke observeres av
# kjøringen selv. `StateDirectory` lar systemd opprette katalogen med
# riktig eier FØR ExecStart og oppgir den i $STATE_DIRECTORY. Samme
# katalog og samme eier som artefaktryddingen og begrepssveipen — de
# deler Unix-identitet, så et eget navn ville bare gitt tre kataloger
# med samme rettigheter.
StateDirectory=disponit
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
CapabilityBoundingSet=
AmbientCapabilities=
LoadCredential=DISPONIT_PERSONVERNSVEIP_URL:/etc/disponit/personvernsveip/DISPONIT_PERSONVERNSVEIP_URL
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_personvernsveip
# Sveipen er ETT funksjonskall som gjør tre setninger per tenant, alle
# dekket av delindeksen `personvernsak_apen_frist`. Går dette over ti
# minutter, henger noe — og da er avbrudd riktig svar: funnene er
# idempotente, så neste døgn tar kjøringen igjen.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
