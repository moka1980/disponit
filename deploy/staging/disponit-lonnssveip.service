# M-39 (113): lønnssveipen for timer uten plan, avvik og overtid.
#
# Sveipen legger INGEN logikk oppå regelen. Regelen eies av databasen
# (113): timer ført uten en plan å måles mot, når fristen er ute, er
# `time_uten_arbeidsplan`; ført tid som avviker fra planen utover
# tenantens grense er `avvik_mot_plan`; tid over normaltid — per dag
# ELLER per uke — er `overtid`; en dag ført på en annen kode enn planens
# er `ukjent_prosjektkode`; og en tenant uten grenser er `ingen_terskel`.
#
# SVEIPEN UTBETALER INGENTING OG PRODUSERER INGEN LØNNSFIL. Den kunne —
# den vet nøyaktig hvor mange minutter hver ansatt har ført. Men en
# lønnsfil er ikke en betaling, det er en FIL: den ser harmløs ut, den
# kan «bare genereres», og den er nettopp derfor farligere enn en enkelt
# utbetaling. Den rammer ALLE på én gang, og den rammer noen som har
# regnet med beløpet.
#
# `ProtectSystem=strict` OG `PrivateTmp=true` ER DERFOR ET GJERDE HER,
# ikke bare en formalitet: enheten har ingen skrivbar sti utenfor
# `StateDirectory`. Det gjerdet kan ikke hindre alt; det egentlige
# gjerdet står i koden (`lonnssveip.py` importerer verken `csv`,
# `open()` eller `pathlib`) og i porten som måler det.
#
# OVERTID ER ET FUNN, IKKE ET FLAGG. Sveipen setter ingen kolonne og går
# videre; den skriver en rad noen må se på.
#
# ETT FUNN, IKKE ETT PER DØGN. Idempotensen bor i basen.
#
# TO SAMMENHENGENDE FEILEDE KJØRINGER → ALARM. En stille lønnssveip er
# overtid ingen har sett.
#
# ROLLEN ER JOBBENS EGEN. `disponit_lonnssveip` har nøyaktig ÉN
# rettighet: EXECUTE på `m39_sveip_lonnsgrunnlag`. INGEN
# tabellrettigheter.
#
# UNIX-IDENTITETEN ER DRIFTSTIMERNES, `disponit-domener`.

[Unit]
Description=Disponit lonnssveip (timer uten plan, avvik og overtid -> funn)

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
# Se disponit-domenerevalidering.service: `drift` (platform/) og `db`
# (platform/core/db) er søskenpakker, ikke nøstet — releaseroten alene
# eksponerer ingen av dem.
WorkingDirectory=/opt/disponit/aktiv/platform
Environment=PYTHONPATH=/opt/disponit/aktiv/platform/core
# Feiltelleren lever i en fil fordi hver kjøring er en egen prosess
# (`Type=oneshot`): «to feilede kjøringer på rad» kan ikke observeres av
# kjøringen selv. `StateDirectory` lar systemd opprette katalogen med
# riktig eier FØR ExecStart og oppgir den i $STATE_DIRECTORY. Samme
# katalog og samme eier som de andre sveipene — de deler Unix-identitet,
# så et eget navn ville bare gitt enda en katalog med samme rettigheter.
StateDirectory=disponit
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
CapabilityBoundingSet=
AmbientCapabilities=
LoadCredential=DISPONIT_LONNSSVEIP_URL:/etc/disponit/lonnssveip/DISPONIT_LONNSSVEIP_URL
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_lonnssveip
# Sveipen er ETT funksjonskall som gjør to setninger per tenant, begge
# indeksdekket (`lonnstaker_aktive`, `timeregistrering_oppslag`,
# `arbeidsplan_oppslag`, `lonnsfunn_apne`). Går dette over ti minutter,
# henger noe — og da er avbrudd riktig svar: funnene er idempotente, så
# neste døgn tar kjøringen igjen.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
