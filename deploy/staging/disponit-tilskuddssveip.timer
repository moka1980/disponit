# M-51 (119): én gang i døgnet.
#
# Kadensen og regelen hører sammen: `frist_varsel_dogn` og
# `kildepost_gyldig_dogn` måles begge i DØGN.
#
# KLOKKESLETTET ER 09:35 fordi 02:20 til 09:20 alt er tatt, og fordi
# klyngefundamentet fordelte 08:50–09:50 til klynge 6.
#
# `Persistent=true` er ekstra viktig her: en vert som var nede da
# tidspunktet passerte skal likevel oppdage en søknadsfrist som
# nærmer seg.

[Unit]
Description=Disponit tilskuddssveip-timer

[Timer]
OnCalendar=*-*-* 09:35:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
