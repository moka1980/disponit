# M-36 (132): én gang i døgnet.
#
# Kadensen og regelen hører sammen: `maalefrist_dogn` måles i DØGN, og
# en rangeringspost har en horisont som slutter på en DATO. Å sveipe
# oftere ville ikke gitt et eneste nytt funn; å sveipe sjeldnere ville
# latt en målefrist passere mellom to kjøringer, og da hadde en effekt
# stått umålt uten at noen visste det.
#
# `Persistent=true`: en vert som var nede da tidspunktet passerte skal
# likevel oppdage at en effekt står umålt. Uten den ville nedetid
# blitt til stillhet om nettopp det modulen finnes for.
#
# ---------------------------------------------------------------------
# HISTORIKK — ALLE KLOKKESLETTENE UNDER ER UTGÅTT.
#
# Da denne timeren ble skrevet (132) sto den på 11:50, og regnestykket
# 11:50 + 10 + 10 = 12:10 gikk IKKE opp mot en statussveip på 12:05.
# Derfor flyttet 132 statussveipen til 12:20. `RandomizedDelaySec` ble
# satt fra 30 til 10 etter 131s lærdom — med 30 minutters spredning
# kunne sveipen kjøre forbi statussveipen og gi en falsk «uteblitt».
#
# ---------------------------------------------------------------------
# GJELDENDE FORM, OG EN PRESISERING SOM ER VERDT Å HA MED.
#
# Det sto her at «en rangering laget før dagens øvrige sveip har kjørt
# ville hvilt på gårsdagens funnbilde». DEN SETNINGEN GJALDT DØRA
# `m36_rangere`, IKKE SVEIPEN. Det er `m36_rangere` som leser de åpne
# funnene fra 33 registre, og den kalles av et menneske gjennom API-et
# — ikke av `m36_sveip_optimalisering`, som bare måler effekten av
# rangeringer som alt er laget.
#
# TRINNET ER 5 MINUTTER OG SPREDNINGEN 4 (5/9).
#
# FØR VAR TRINNET 15 OG SPREDNINGEN 30. En sveip på 04:05 kunne altså
# starte 04:35, og den på 04:20 kunne starte 04:50 — STIGEN OVERLAPPET
# SEG SELV. Nå er spredningen MINDRE enn trinnet, så to planlagte
# tider ikke kan overlappe.
#
# Stigen ble kortere av det samme grepet: 35 sveip à 5 minutter er
# 04:00–06:50 mot 04:05–13:20 før. `disponit-sveipestatus.timer` (115)
# står bakerst på 07:30.
#
# KLOKKESLETTET ER 06:30.
#
# `AccuracySec=1us` OG IKKE STANDARDVERDIEN.
#
# systemds standard er ETT MINUTT, og den er ikke en presisjonsgrense
# — den er en LISENS TIL Å SLÅ SAMMEN. systemd forskyver timere
# innenfor vinduet for å vekke maskinen færre ganger, og med 35 timere
# betyr det at flere av dem kan fyre i samme sekund.
#
# DA VILLE SPREDNINGEN VÆRT OPPHEVET AV DEN SOM SKULLE HÅNDHEVE DEN.
# Hele stigen hviler på at planlagte tider ligger fra hverandre, og
# `RandomizedDelaySec` på fire minutter er meningsløs hvis systemd
# samler resultatet tilbake til minuttet.
#
# CodeRabbit fant det 5/9, samme natt som spredningen ble strammet.

[Unit]
Description=Disponit optimalisatorsveip-timer

[Timer]
OnCalendar=*-*-* 06:30:00 UTC
RandomizedDelaySec=4min
AccuracySec=1us
Persistent=true

[Install]
WantedBy=timers.target
