# PR-015 §6: opprydding av staged artefakter.
#
# Timeren legger INGEN logikk oppå den positive regelen. Regelen eies av
# databasen (016): `staged` eldre enn 24 t OG uten refererende kvittering.
# Timeren kaller `rydd_staged_artefakter(500)` — samme predikat, med en bunn,
# så en opphopning ikke låser tabellen i én transaksjon.
#
# Karantenesatt evidens telles og RAPPORTERES, aldri ryddes: den er ikke
# `staged` og nås ikke av predikatet. Men en ryddejobb som ikke sier hvor mye
# den bevarer, skjuler at disken vokser av noe den aldri får røre.
#
# To sammenhengende feilede kjøringer → alarm. En stille ryddejobb er en
# voksende disk.

[Unit]
Description=Disponit artefaktrydding

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
# Se disponit-domenerevalidering.service: `drift` (platform/) og `db`
# (platform/core/db) er søskenpakker, ikke nøstet — releaseroten alene
# eksponerer ingen av dem.
WorkingDirectory=/opt/disponit/aktiv/platform
Environment=PYTHONPATH=/opt/disponit/aktiv/platform/core
# Feiltelleren i §6 lever i en fil fordi hver kjøring er en egen prosess.
# Uten dette lå filen under root-eide /var/lib, `mkdir` feilet for
# `disponit-domener`, og hver kjøring leste forrige feiltelling som 0 — da
# kan alarmen etter to sammenhengende feil ALDRI utløses. `StateDirectory`
# lar systemd opprette /var/lib/disponit med riktig eier før ExecStart, og
# eksponerer den som $STATE_DIRECTORY (som arbeideren leser).
StateDirectory=disponit
StateDirectoryMode=0750
LoadCredential=DISPONIT_DOMAINS_URL:/etc/disponit/domener/DISPONIT_DOMAINS_URL
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_artefaktrydding
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
