# PR-015 §2: daglig revalidering av verifiserte domener.
#
# Arbeideren har INGEN egen autoritet: den slår opp DNS og kaller
# `revalider_domenekontroll()`. Statusbeslutningen ligger i databasen.
#
# Egen Unix-bruker og rollen `disponit_domains_admin` — som har EXECUTE på
# funksjonene og INGEN bordtilgang til `domenekontroll`. Utvalget går gjennom
# `revalideringskandidater()` (SECURITY DEFINER), så den kryss-tenant-lesingen
# scheduleren trenger ligger ett sted, revidérbart, i stedet for som et grant
# arbeideren kunne brukt til hva som helst.
#
# Oppstart NEKTES hvis DISPONIT_RESOLVERE bryter diversitetskravet (§2.4):
# minst to resolvere hos ULIKE operatører og ULIKE nett. To resolvere hos samme
# operatør er én feilkilde med to adresser.

[Unit]
Description=Disponit domenerevalidering (resolverarbeider)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
WorkingDirectory=/opt/disponit/aktiv
LoadCredential=DISPONIT_DOMAINS_URL:/etc/disponit/domener/DISPONIT_DOMAINS_URL
LoadCredential=DISPONIT_RESOLVERE:/etc/disponit/domener/DISPONIT_RESOLVERE
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_revalidering
# Én kjøring skal aldri henge og blokkere neste times slott. Advisory-låsen
# gjør en overlappende kjøring til en no-op uansett, men en hengende prosess
# ville holdt låsen.
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
