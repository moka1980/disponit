# M-39 (113): én gang i døgnet.
#
# Kadensen og regelen hører sammen: `uten_plan_dogn` måles i DØGN, og
# både dags- og ukesovertid er utsagn om en avsluttet dag.
#
# KLOKKESLETTET ER 08:05 fordi 03:15 til 07:50 alt er tatt. Sveipens
# første steg leser ALLE tenanters takere, og to slike skann på samme
# sekund legger seg oppå hverandres I/O uten grunn.
#
# `RandomizedDelaySec=30min` og `Persistent=true`: samme begrunnelse som
# nabosveipene.

[Unit]
Description=Disponit lonnssveip-timer

[Timer]
OnCalendar=*-*-* 08:05:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
