# M-9 (095): én gang i døgnet.
#
# Kadensen og varselvinduet hører sammen og skal endres sammen:
# `m9_sveip_utlopte` reiser `utloper_snart` 30 døgn før `gyldig_til`,
# altså 30 × kadensen. Vinduet er ikke et magisk tall — det er det
# korteste som er lengre enn en ferie: en begrepseier som er borte tre
# uker skal komme tilbake til et varsel, ikke til et utløpt begrep.
#
# TETTERE VILLE IKKE GITT BEDRE SVAR. `gyldig_til` er en DATO. En sveip
# hver time ville stilt det samme spørsmålet 24 ganger om dagen og fått
# det samme svaret 23 av dem — funnene er idempotente, så det ville vært
# billig, men det ville ikke vært informasjon. Det som endrer seg
# raskere enn et døgn i denne modulen — at noen registrerer en ny
# versjon — flytter `gjeldende` i SAMME transaksjon, og flaten leser
# alltid det gjeldende begrepet direkte.
#
# `RandomizedDelaySec=30min`: sveipen leser alle tenanters begreper i
# sitt første steg. Fyrer den på nøyaktig samme sekund som resten av
# nattens jobber (backup 03:15, m57-utsending, evidensreaperen), legger
# den seg oppå deres I/O uten grunn — den har ingen frist å rekke.
# Spredningen er også grunnen til at klokkeslettet er 04:20 og ikke et
# rundt tall: nabotimerne står på hele og halve timer.
#
# `Persistent=true`: en vert som var nede da døgnet passerte, kjører én
# sveip ved oppstart. Det er riktig her — sveipen måler NÅ («hvilke
# begreper er utløpt i dag»), ikke da, og et utløpt begrep som ingen har
# fått funn på er nøyaktig det denne timeren finnes for.

[Unit]
Description=Disponit begrepssveip-timer

[Timer]
OnCalendar=*-*-* 04:20:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
