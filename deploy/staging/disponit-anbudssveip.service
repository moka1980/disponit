# M-46 (118): anbudssveipen for frister og udekkede krav.
#
# Sveipen legger INGEN logikk oppå regelen. Regelen eies av databasen
# (118): et anbud som nærmer seg fristen uten klart utkast er
# `frist_naermer_seg`; en frist som gikk er `frist_passert`; et
# absolutt krav uten et punkt som dekker det er
# `udekket_absolutt_krav`; et vektet er `udekket_krav`; et punkt som
# peker på et utløpt dokument er `utlopt_kilde`; et anbud uten
# kravpunkter er `ingen_krav_registrert`; et anbud utenfor
# søkeprofilen er `utenfor_profil`; og en tenant uten profil er
# `ingen_profil`.
#
# SVEIPEN FYLLER INGENTING INN, OG DET ER MODULENS VIKTIGSTE FRAVÆR.
# Den ser hvert udekket krav og hvert kildedokument tenanten har. En
# «hjelpsom» automatikk som fant nærmeste passende kilde og skrev et
# punkt, ville vært nøyaktig det vakten forbyr: «udekkede krav blir
# unntak, ALDRI UTFYLT GJETNING». Og feilen ville vært usynlig — et
# utkast uten hull ser ferdig ut.
#
# SVEIPEN SENDER HELLER INGENTING. Et innsendt tilbud er bindende, og
# fristen gjør det irreversibelt. 118 har ingen «sendt»-kolonne.
#
# DERFOR ER `RestrictAddressFamilies` HER ET GJERDE OG IKKE EN
# FORMALITET. Den slipper AF_INET fordi DATABASEN nås over TCP — ikke
# fordi noe skal ut til Doffin eller TED. Anbudene registreres av et
# menneske som har lest dem i portalen; gjerdet mot automatisk henting
# står i koden (`anbudssveip.py` importerer ingenting som kan snakke
# ut) og i porten som måler det.
#
# ETT FUNN, IKKE ETT PER DØGN. Idempotensen bor i basen.
#
# TO SAMMENHENGENDE FEILEDE KJØRINGER → ALARM. En stille anbudssveip
# er frister ingen har sett.
#
# ROLLEN ER JOBBENS EGEN. `disponit_anbudssveip` har nøyaktig ÉN
# rettighet: EXECUTE på `m46_sveip_anbud`. INGEN tabellrettigheter.
#
# UNIX-IDENTITETEN ER DRIFTSTIMERNES, `disponit-domener`.

[Unit]
Description=Disponit anbudssveip (frister og udekkede krav -> funn)

[Service]
Type=oneshot
User=disponit-domener
Group=disponit-domener
# Se disponit-domenerevalidering.service: `drift` (platform/) og `db`
# (platform/core/db) er søskenpakker, ikke nøstet — releaseroten alene
# eksponerer ingen av dem.
WorkingDirectory=/opt/disponit/aktiv/platform
Environment=PYTHONPATH=/opt/disponit/aktiv/platform/core
# Feiltelleren lever i en fil fordi hver kjøring er en egen prosess
# (`Type=oneshot`): «to feilede kjøringer på rad» kan ikke observeres av
# kjøringen selv. `StateDirectory` lar systemd opprette katalogen med
# riktig eier FØR ExecStart og oppgir den i $STATE_DIRECTORY. Samme
# katalog og samme eier som de andre sveipene — de deler Unix-identitet,
# så et eget navn ville bare gitt enda en katalog med samme rettigheter.
StateDirectory=disponit
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
CapabilityBoundingSet=
AmbientCapabilities=
LoadCredential=DISPONIT_ANBUDSSVEIP_URL:/etc/disponit/anbudssveip/DISPONIT_ANBUDSSVEIP_URL
ExecStart=/opt/disponit/.venv/bin/python -m drift.kjor_anbudssveip
# Sveipen er ETT funksjonskall som gjør to setninger per tenant, begge
# indeksdekket (`anbud_aktive_frist`,
# `kvalifikasjonskrav_anbud`, `utkastpunkt_utkast`,
# `anbudsfunn_apne`). Går dette over ti
# minutter, henger noe — og da er avbrudd riktig svar: funnene er
# idempotente, så neste døgn tar kjøringen igjen.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
