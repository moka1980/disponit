# 115: én gang i døgnet, ETTER hele sveipestigen.
#
# KLOKKESLETTET ER 12:05 UTC fordi rekkefølgen er poenget:
# observatøren skal lese flåtens tilstand ETTER at flåten har kjørt,
# ikke før. Kjørte den 02:00, ville hver eneste sveip sett ut som
# «ikke kjørt i dag», og varselet vært en falsk alarm hver natt.
#
# DEN HAR FLYTTET TO GANGER, OG BEGGE GANGER PÅ SAMME MÅTE. Den sto
# 08:35 til M-48 (116) kom, og 10:05 gjennom hele klynge 6. Nå
# fordeler klynge 7 (121–125) 10:05–11:05 til fem nye sveip, og
# observatøren flyttes BAKENFOR HELE den stigen med én gang i stedet
# for å skyves femten minutter fem ganger.
#
# GAPET FRA 09:50 TIL 12:05 ER TOMT I DAG og fylles etter hvert som
# M-54, M-52, M-47, M-50 og M-53 lander. Det er med vilje: klyngens
# fundament flytter observatøren FØR modulene kommer, så ingen
# modul-PR trenger å røre denne fila — og to PR-er som begge flyttet
# den ville gitt en fletting der et tapt klokkeslett ser ut som
# ingenting. `test_timeren_gaar_etter_hele_stigen` holder rekkefølgen
# ærlig uansett hvilken vei det går.
#
# 08:35 STÅR IKKE LEDIG LENGER: M-15 (128) tok det.
#
# FLYTTET FRA 11:20 TIL 12:05 I M-33s PR (130). Klynge 8 la de to
# siste sveipene BAK klynge 7 — M-33 på 11:35 og M-36 på 11:50 — og en
# statussveip som ble stående på 11:20 ville lest flåtens tilstand FØR
# to av medlemmene hadde kjørt. Den ville rapportert dem som uteblitt
# hver eneste natt.
#
# FLYTTINGEN HØRTE TIL DEN FØRSTE TIMEREN BAK 11:20, ikke til
# fundamentet: et fundament som endrer drift for noe som ennå ikke
# finnes, gjetter. Da M-33 kom, var flyttingen en måling — og
# `test_timeren_gaar_etter_hele_stigen` er den målingen.
#
# `RandomizedDelaySec=15min` og ikke 30: vinduet må være ferdig før
# varselsenderen henter køen, og spredningen har mindre å tjene her —
# jobben leser 22 småfiler, den skanner ingen tabell.
#
# `Persistent=true`: en vert som var nede da tidspunktet passerte,
# fører flåtens tilstand én gang når den kommer opp. Det er nettopp da
# observasjonen er mest verdt.

[Unit]
Description=Disponit sveipestatus-timer

[Timer]
OnCalendar=*-*-* 12:05:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
