{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-rollback-m37-v1.json",
  "title": "m37-rollback-v1 — flippedrillen for unntakskøens arbeider (lease-formen)",
  "comment": "Produsert av deploy/staging/rollback-m37.py. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_m37_rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "identiteter",
    "maalt",
    "etterkontroll"
  ],
  "properties": {
    "krav_id": {
      "type": "string",
      "const": "m37-rollback-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "miljo",
        "vert",
        "unit",
        "tenant",
        "drillet_release",
        "forgjenger_release",
        "drillet_katalog",
        "forgjenger_katalog",
        "drillet_digest",
        "forgjenger_digest",
        "kandidat_digest",
        "lease_s",
        "instrument",
        "sakskilde"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "const": "m37_unntak"
        },
        "miljo": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "const": "disponit-m37"
        },
        "tenant": {
          "type": "string",
          "pattern": "^t-m37drill-[0-9a-f]{6}$"
        },
        "drillet_release": {
          "type": "string",
          "minLength": 1
        },
        "forgjenger_release": {
          "type": "string",
          "minLength": 1
        },
        "drillet_katalog": {
          "type": "string",
          "minLength": 1
        },
        "forgjenger_katalog": {
          "type": "string",
          "minLength": 1
        },
        "drillet_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forgjenger_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kandidat_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lease_s": {
          "type": "number",
          "minimum": 30,
          "maximum": 600
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "sakskilde": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identiteter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_sak_id",
        "inflight_sak_id",
        "kandidat_sak_id",
        "drillet_pid",
        "rullback_pid",
        "kandidat_pid",
        "inflight_claim_id_prefiks"
      ],
      "properties": {
        "probe_sak_id": {
          "type": "string",
          "minLength": 1
        },
        "inflight_sak_id": {
          "type": "string",
          "minLength": 1
        },
        "kandidat_sak_id": {
          "type": "string",
          "minLength": 1
        },
        "drillet_pid": {
          "type": "integer",
          "minimum": 1
        },
        "rullback_pid": {
          "type": "integer",
          "minimum": 1
        },
        "kandidat_pid": {
          "type": "integer",
          "minimum": 1
        },
        "inflight_claim_id_prefiks": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_utfall",
        "probe_claim_generation",
        "inflight_status_ved_rulling",
        "inflight_claim_generation_ved_rulling",
        "inflight_lease_rest_s_ved_rulling",
        "arbeider_ventet_paa_policyer",
        "fencing_treff_for_rulling",
        "drillet_dod_innen_s",
        "laasvindu_s",
        "overtakelse_claim_generation",
        "overtakelse_ventetid_s",
        "claim_utlopt_hendelser",
        "claims_totalt",
        "fencing_treff_etter_overtakelse",
        "gammel_claim_traff_rader",
        "inflight_utfall",
        "behandlinger_av_inflight",
        "behandlinger_under_gammel_claim",
        "oppdrag_for_inflight",
        "rullback_cwd_er_forgjengerens",
        "kandidat_cwd_er_aktiv",
        "kandidat_claim_generation",
        "kandidat_utfall",
        "release_digest_bundet"
      ],
      "properties": {
        "probe_utfall": {
          "type": "string",
          "minLength": 1
        },
        "probe_claim_generation": {
          "type": "integer",
          "minimum": 0
        },
        "inflight_status_ved_rulling": {
          "type": "string",
          "minLength": 1
        },
        "inflight_claim_generation_ved_rulling": {
          "type": "integer",
          "minimum": 0
        },
        "inflight_lease_rest_s_ved_rulling": {
          "type": "number"
        },
        "arbeider_ventet_paa_policyer": {
          "type": "integer",
          "minimum": 0
        },
        "fencing_treff_for_rulling": {
          "type": "integer",
          "minimum": 0
        },
        "drillet_dod_innen_s": {
          "type": "number",
          "minimum": 0
        },
        "laasvindu_s": {
          "type": "number",
          "minimum": 0
        },
        "overtakelse_claim_generation": {
          "type": "integer",
          "minimum": 0
        },
        "overtakelse_ventetid_s": {
          "type": "number",
          "minimum": 0
        },
        "claim_utlopt_hendelser": {
          "type": "integer",
          "minimum": 0
        },
        "claims_totalt": {
          "type": "integer",
          "minimum": 0
        },
        "fencing_treff_etter_overtakelse": {
          "type": "integer",
          "minimum": 0
        },
        "gammel_claim_traff_rader": {
          "type": "integer",
          "minimum": 0
        },
        "inflight_utfall": {
          "type": "string",
          "minLength": 1
        },
        "behandlinger_av_inflight": {
          "type": "integer",
          "minimum": 0
        },
        "behandlinger_under_gammel_claim": {
          "type": "integer",
          "minimum": 0
        },
        "oppdrag_for_inflight": {
          "type": "integer",
          "minimum": 0
        },
        "rullback_cwd_er_forgjengerens": {
          "type": "boolean"
        },
        "kandidat_cwd_er_aktiv": {
          "type": "boolean"
        },
        "kandidat_claim_generation": {
          "type": "integer",
          "minimum": 0
        },
        "kandidat_utfall": {
          "type": "string",
          "minLength": 1
        },
        "release_digest_bundet": {
          "type": "boolean"
        }
      }
    },
    "etterkontroll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_aktiv",
        "unit_override_fjernet",
        "heartbeat_alder_s",
        "uventede_restarter",
        "digest_likhet",
        "rullback_bytes_er_forgjengerens"
      ],
      "properties": {
        "unit_aktiv": {
          "type": "boolean"
        },
        "unit_override_fjernet": {
          "type": "boolean"
        },
        "heartbeat_alder_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "uventede_restarter": {
          "type": "integer",
          "minimum": 0
        },
        "digest_likhet": {
          "type": "boolean"
        },
        "rullback_bytes_er_forgjengerens": {
          "type": "boolean"
        }
      }
    }
  }
}
