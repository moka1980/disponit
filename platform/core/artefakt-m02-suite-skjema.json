{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://disponit.no/skjema/m02suiteartefakt-v1.json",
  "title": "m02 suiteartefakt (m02-suite-v1)",
  "comment": "Suitekjoeringen PAA STAGING som artefakt, med M-2s andel NAVNGITT (m02-aksept-klarsignalet paragraf 3). Skrevet av deploy/staging/m02-suite-artefakt.py fra pytest-kjoeringen - aldri for haand. Grensene staar i KRAVGRENSER.",
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "const": "m02-suite-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "commit",
        "vert",
        "m2_filer"
      ],
      "properties": {
        "modul": {
          "const": "m02_revisjonslogg"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "m2_filer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "comment": "Filene som ER M-2s andel - navngitt, ikke antatt (delingsbetingelsen i RUTINER.md)."
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tester_totalt",
        "tester_feilet",
        "m2_tester",
        "m2_feilet"
      ],
      "properties": {
        "tester_totalt": {
          "type": "integer",
          "minimum": 0
        },
        "tester_feilet": {
          "type": "integer",
          "minimum": 0
        },
        "m2_tester": {
          "type": "integer",
          "minimum": 0
        },
        "m2_feilet": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
