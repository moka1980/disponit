{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-suite-v1.json",
  "title": "<modul>-suite-v1 — hele testsuiten på staging, modulens andel for seg",
  "comment": "ÉN form for alle moduler (17/9). Tallene leses av pytests egen junit-XML, aldri av oppsummeringsteksten. Skrevet av deploy/staging/suite-artefakt.py; porten er manifestskjema._grenser_generisk_suite, som binder modul-id, andelens filliste og produsentflatens digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["krav_id", "ts", "bestatt", "oppsett", "maalt"],
  "properties": {
    "krav_id": {"type": "string", "pattern": "^m[0-9]{1,2}-suite-v1$"},
    "ts": {"type": "string", "minLength": 1},
    "bestatt": {"type": "boolean"},
    "feil": {"type": "array", "items": {"type": "string"}},
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modul", "commit", "vert", "andel_filer", "bevisrot_sha256"],
      "properties": {
        "modul": {"type": "string", "pattern": "^m[0-9]{2}_[a-z_]+$"},
        "commit": {"type": "string", "minLength": 7},
        "vert": {"type": "string", "minLength": 1},
        "andel_filer": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^platform/core/tests/test_.*\\.py$"}
        },
        "bevisrot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tester_totalt", "tester_feilet", "tester_hoppet",
                   "andel_tester", "andel_feilet", "andel_hoppet",
                   "suite_exitkode", "andel_exitkode"],
      "properties": {
        "tester_totalt": {"type": "integer", "minimum": 0},
        "tester_feilet": {"type": "integer", "minimum": 0},
        "tester_hoppet": {"type": "integer", "minimum": 0},
        "andel_tester": {"type": "integer", "minimum": 0},
        "andel_feilet": {"type": "integer", "minimum": 0},
        "andel_hoppet": {"type": "integer", "minimum": 0},
        "suite_exitkode": {"type": "integer"},
        "andel_exitkode": {"type": "integer"}
      }
    }
  }
}
