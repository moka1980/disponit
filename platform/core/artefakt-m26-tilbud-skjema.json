{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://disponit.no/skjema/m26tilbudartefakt-v1.json",
  "title": "M-26 tilbudsartefakt (m26-tilbud-v1)",
  "comment": "ARC B tilbud, de ti punktene (PR 6). Hvert punkt er et par (forsok, brudd) - null brudd uten minst ett forsok er en port som aldri kjorte. Feltsettet er generert fra manifestskjema.M26_TILBUD_INVARIANTER, aldri for haand; grensene staar i KRAVGRENSER.",
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt",
    "funn"
  ],
  "properties": {
    "krav_id": {
      "const": "m26-tilbud-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "commit",
        "vert",
        "tenant"
      ],
      "properties": {
        "modul": {
          "const": "m26_prisbok"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string"
        },
        "notat": {
          "type": "string"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tilbud_uten_policy_forsok",
        "tilbud_uten_policy_brudd",
        "tilbud_uten_godkjenning_forsok",
        "tilbud_uten_godkjenning_brudd",
        "priser_utenfor_boka_forsok",
        "priser_utenfor_boka_brudd",
        "klausul_erstattet_forsok",
        "klausul_erstattet_brudd",
        "belop_over_policyens_tak_forsok",
        "belop_over_policyens_tak_brudd",
        "dobbel_bestilling_samme_tilbud_forsok",
        "dobbel_bestilling_samme_tilbud_brudd",
        "dobbel_sending_samme_oppdrag_forsok",
        "dobbel_sending_samme_oppdrag_brudd",
        "utlopt_eller_uten_linjer_forsok",
        "utlopt_eller_uten_linjer_brudd",
        "kvittering_uten_bokforing_forsok",
        "kvittering_uten_bokforing_brudd",
        "kill_switch_konsumerte_tilbud_forsok",
        "kill_switch_konsumerte_tilbud_brudd",
        "rundtur_paa_disponit_com"
      ],
      "properties": {
        "tilbud_uten_policy_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "tilbud_uten_policy_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "tilbud_uten_godkjenning_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "tilbud_uten_godkjenning_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "priser_utenfor_boka_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "priser_utenfor_boka_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "klausul_erstattet_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "klausul_erstattet_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "belop_over_policyens_tak_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "belop_over_policyens_tak_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_bestilling_samme_tilbud_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_bestilling_samme_tilbud_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_sending_samme_oppdrag_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_sending_samme_oppdrag_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "utlopt_eller_uten_linjer_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "utlopt_eller_uten_linjer_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "kvittering_uten_bokforing_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "kvittering_uten_bokforing_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_konsumerte_tilbud_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_konsumerte_tilbud_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "rundtur_paa_disponit_com": {
          "type": "boolean",
          "description": "Bevisrunden gikk mot disponit.com med et EKTE oppdrag gjennom modulen (ikke stub-SMTP) - kvitteringen staar i basen."
        }
      }
    },
    "funn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alvor",
          "tekstnokkel"
        ],
        "properties": {
          "alvor": {
            "enum": [
              "rodt",
              "gult"
            ]
          },
          "tekstnokkel": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "detalj": {
            "type": "object"
          }
        }
      },
      "description": "Funnene som tekstnokler + parametre (aldri fritekst-PII)."
    }
  }
}
