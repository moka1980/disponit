{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-sveip-feilinjisering-v1.json",
  "title": "<modul>-feilinjisering-v1 — en injisert driftsfeil mot en sveipmodul",
  "comment": "Produsert av deploy/staging/sveip-feilinjisering.py, samme produsent for alle sveipmoduler. Feilen injiseres i transporten: kjøringen får en tilkobling uten EXECUTE på sveipedøra, og `injeksjonsrolle_har_execute` er den positive kontrollen av at injeksjonen var ekte. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_sveip_feilinjisering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "type": "string",
      "pattern": "^m[0-9]+-feilinjisering-v1$"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "vert",
        "funntabell",
        "tenantkilde",
        "sveipedor",
        "injeksjonsrolle",
        "injeksjon",
        "bevisrot_sha256"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "funntabell": {
          "type": "string",
          "minLength": 1
        },
        "sveipedor": {
          "type": "string",
          "minLength": 1
        },
        "injeksjonsrolle": {
          "type": "string",
          "minLength": 1
        },
        "injeksjon": {
          "type": "string",
          "minLength": 1
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tenantkilde": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frisk_feilet",
        "injeksjonsrolle_har_execute",
        "injiserte_kjoringer",
        "injisert_feilet",
        "alarm_etter_forste",
        "alarm_etter_andre",
        "apne_for",
        "apne_etter",
        "lukkede_for",
        "lukkede_etter",
        "registeret_urort",
        "per_type_for",
        "per_type_etter",
        "tenanter"
      ],
      "properties": {
        "frisk_feilet": {
          "type": "boolean"
        },
        "injeksjonsrolle_har_execute": {
          "type": "boolean"
        },
        "injiserte_kjoringer": {
          "type": "integer",
          "minimum": 0
        },
        "injisert_feilet": {
          "type": "integer",
          "minimum": 0
        },
        "alarm_etter_forste": {
          "type": "boolean"
        },
        "alarm_etter_andre": {
          "type": "boolean"
        },
        "apne_for": {
          "type": "integer",
          "minimum": 0
        },
        "apne_etter": {
          "type": "integer",
          "minimum": 0
        },
        "lukkede_for": {
          "type": "integer",
          "minimum": 0
        },
        "lukkede_etter": {
          "type": "integer",
          "minimum": 0
        },
        "registeret_urort": {
          "type": "boolean"
        },
        "per_type_for": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "per_type_etter": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tenanter": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
