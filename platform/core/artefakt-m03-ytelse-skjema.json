{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-m03-ytelse-v1.json",
  "title": "m03-ytelse-v1 — den ekte jobben mot driftsbasen (ADR-002 D4)",
  "comment": "Produsert av deploy/staging/m03-lest.py. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_m03_*.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "const": "m03-ytelse-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "bevisrot_sha256",
        "modul",
        "runder",
        "vert"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "runder": {
          "type": "integer"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feilede",
        "kjoringer",
        "maks_sekunder",
        "regler_maalt",
        "umaalbare"
      ],
      "properties": {
        "kjoringer": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sekunder",
              "regler",
              "umaalbare",
              "avbrutt",
              "feilet",
              "hoppet_over",
              "returkode"
            ],
            "properties": {
              "sekunder": {
                "type": "number"
              },
              "regler": {
                "type": "integer"
              },
              "umaalbare": {
                "type": "integer"
              },
              "avbrutt": {
                "type": "boolean"
              },
              "feilet": {
                "type": "boolean"
              },
              "hoppet_over": {
                "type": "boolean"
              },
              "returkode": {
                "type": "integer"
              }
            }
          }
        },
        "maks_sekunder": {
          "type": "number"
        },
        "regler_maalt": {
          "type": "integer"
        },
        "umaalbare": {
          "type": "integer"
        },
        "feilede": {
          "type": "integer"
        }
      }
    }
  }
}
