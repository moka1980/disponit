{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://disponit.no/skjema/m14bokforingartefakt-v1.json",
  "title": "M-14 bokforingsartefakt (m14-bokforing-v1)",
  "comment": "ARC B bokforing, de ti punktene (PR 5). Hvert punkt er et par (forsok, brudd) - null brudd uten minst ett forsok er en port som aldri kjorte. Feltsettet er generert fra manifestskjema.M14_BOKFORING_INVARIANTER, aldri for haand; grensene staar i KRAVGRENSER.",
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt",
    "funn"
  ],
  "properties": {
    "krav_id": {
      "const": "m14-bokforing-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "commit",
        "vert",
        "tenant"
      ],
      "properties": {
        "modul": {
          "const": "m14_fakturakontroll"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string"
        },
        "notat": {
          "type": "string"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bokforing_uten_policy_forsok",
        "bokforing_uten_policy_brudd",
        "bokforing_med_kontrollavvik_forsok",
        "bokforing_med_kontrollavvik_brudd",
        "bokforing_over_belopsgrense_forsok",
        "bokforing_over_belopsgrense_brudd",
        "dobbel_bestilling_samme_faktura_forsok",
        "dobbel_bestilling_samme_faktura_brudd",
        "dobbel_bokforing_samme_oppdrag_forsok",
        "dobbel_bokforing_samme_oppdrag_brudd",
        "bilag_avviker_fra_fakturaen_forsok",
        "bilag_avviker_fra_fakturaen_brudd",
        "bokforing_uten_manuell_kontroll_over_grensen_forsok",
        "bokforing_uten_manuell_kontroll_over_grensen_brudd",
        "bokforing_av_avvist_eller_bokfort_forsok",
        "bokforing_av_avvist_eller_bokfort_brudd",
        "kvittering_uten_bokforing_forsok",
        "kvittering_uten_bokforing_brudd",
        "kill_switch_konsumerte_fakturaer_forsok",
        "kill_switch_konsumerte_fakturaer_brudd",
        "rundtur_paa_disponit_com"
      ],
      "properties": {
        "bokforing_uten_policy_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_uten_policy_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_med_kontrollavvik_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_med_kontrollavvik_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_over_belopsgrense_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_over_belopsgrense_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_bestilling_samme_faktura_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_bestilling_samme_faktura_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_bokforing_samme_oppdrag_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "dobbel_bokforing_samme_oppdrag_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "bilag_avviker_fra_fakturaen_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "bilag_avviker_fra_fakturaen_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_uten_manuell_kontroll_over_grensen_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_uten_manuell_kontroll_over_grensen_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_av_avvist_eller_bokfort_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "bokforing_av_avvist_eller_bokfort_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "kvittering_uten_bokforing_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "kvittering_uten_bokforing_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_konsumerte_fakturaer_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_konsumerte_fakturaer_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "rundtur_paa_disponit_com": {
          "type": "boolean",
          "description": "Bevisrunden gikk mot disponit.com med et EKTE oppdrag gjennom modulen (ikke stub-SMTP) - kvitteringen staar i basen."
        }
      }
    },
    "funn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alvor",
          "tekstnokkel"
        ],
        "properties": {
          "alvor": {
            "enum": [
              "rodt",
              "gult"
            ]
          },
          "tekstnokkel": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "detalj": {
            "type": "object"
          }
        }
      },
      "description": "Funnene som tekstnokler + parametre (aldri fritekst-PII)."
    }
  }
}
