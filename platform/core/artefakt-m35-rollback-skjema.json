{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-m35-rollback-v1.json",
  "title": "m35-rollback-v1 — forgjengerens og kandidatens kjerne svarer likt på samme register (ADR-002 D3)",
  "comment": "Produsert av deploy/staging/m35-lest.py. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_m35_*.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "const": "m35-rollback-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "bevisrot_sha256",
        "forgjenger",
        "kjerne_forgjenger",
        "kjerne_kandidat",
        "modul",
        "modul_forgjenger",
        "modul_kandidat",
        "runde",
        "vert"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "runde": {
          "type": "string",
          "minLength": 1
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forgjenger": {
          "type": "string",
          "minLength": 1
        },
        "kjerne_forgjenger": {
          "type": "string",
          "minLength": 1
        },
        "kjerne_kandidat": {
          "type": "string",
          "minLength": 1
        },
        "modul_forgjenger": {
          "type": "string",
          "minLength": 1
        },
        "modul_kandidat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kandidat_baerer_riggen",
        "kandidat_status",
        "rullbakk_status",
        "svar_like"
      ],
      "properties": {
        "rullbakk_status": {
          "type": "integer"
        },
        "kandidat_status": {
          "type": "integer"
        },
        "svar_like": {
          "type": "boolean"
        },
        "kandidat_baerer_riggen": {
          "type": "boolean"
        }
      }
    }
  }
}
