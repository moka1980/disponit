{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://disponit.no/skjema/m6svarartefakt-v1.json",
  "title": "M-6 svarartefakt (m6-svar-v1)",
  "comment": "M-6 svararmen, de elleve punktene (PR 5). Hvert punkt er et par (forsok, brudd) - null brudd uten minst ett forsok er en port som aldri kjorte. Feltsettet er generert fra manifestskjema.M6_SVAR_INVARIANTER, aldri for haand; grensene staar i KRAVGRENSER.",
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt",
    "funn"
  ],
  "properties": {
    "krav_id": {
      "const": "m6-svar-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "commit",
        "vert",
        "tenant"
      ],
      "properties": {
        "modul": {
          "const": "m06_epost"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string"
        },
        "notat": {
          "type": "string"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utkast_i_klartekst_i_basen_forsok",
        "utkast_i_klartekst_i_basen_brudd",
        "dom_uten_aktor_eller_tidspunkt_forsok",
        "dom_uten_aktor_eller_tidspunkt_brudd",
        "sendt_satt_av_en_dom_forsok",
        "sendt_satt_av_en_dom_brudd",
        "utkast_til_slettet_melding_forsok",
        "utkast_til_slettet_melding_brudd",
        "utkastvei_uten_eget_scope_forsok",
        "utkastvei_uten_eget_scope_brudd",
        "sendingen_ble_en_agenthandling_forsok",
        "sendingen_ble_en_agenthandling_brudd",
        "sendt_uten_samtykkets_sendescope_forsok",
        "sendt_uten_samtykkets_sendescope_brudd",
        "sendt_noe_som_ikke_sto_i_ko_forsok",
        "sendt_noe_som_ikke_sto_i_ko_brudd",
        "utsending_med_egen_mottaker_forsok",
        "utsending_med_egen_mottaker_brudd",
        "feilgrunn_med_persondata_forsok",
        "feilgrunn_med_persondata_brudd",
        "forbigaende_feil_konsumerte_koen_forsok",
        "forbigaende_feil_konsumerte_koen_brudd",
        "rundtur_paa_disponit_com"
      ],
      "properties": {
        "utkast_i_klartekst_i_basen_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "utkast_i_klartekst_i_basen_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "dom_uten_aktor_eller_tidspunkt_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "dom_uten_aktor_eller_tidspunkt_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "sendt_satt_av_en_dom_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "sendt_satt_av_en_dom_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "utkast_til_slettet_melding_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "utkast_til_slettet_melding_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "utkastvei_uten_eget_scope_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "utkastvei_uten_eget_scope_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "sendingen_ble_en_agenthandling_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "sendingen_ble_en_agenthandling_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "sendt_uten_samtykkets_sendescope_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "sendt_uten_samtykkets_sendescope_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "sendt_noe_som_ikke_sto_i_ko_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "sendt_noe_som_ikke_sto_i_ko_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "utsending_med_egen_mottaker_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "utsending_med_egen_mottaker_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "feilgrunn_med_persondata_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "feilgrunn_med_persondata_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "forbigaende_feil_konsumerte_koen_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "forbigaende_feil_konsumerte_koen_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "rundtur_paa_disponit_com": {
          "type": "boolean",
          "description": "Bevisrunden gikk mot disponit.com: eieren svarte fra flaten paa en melding i sin EGEN postboks, og svaret kom fram i traaden - ikke en stub-Graph."
        }
      }
    },
    "funn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alvor",
          "tekstnokkel"
        ],
        "properties": {
          "alvor": {
            "enum": [
              "rodt",
              "gult"
            ]
          },
          "tekstnokkel": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "detalj": {
            "type": "object"
          }
        }
      },
      "description": "Funnene som tekstnokler + parametre (aldri fritekst-PII)."
    }
  }
}
