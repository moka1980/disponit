{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://disponit.no/skjema/m6inntakartefakt-v1.json",
  "title": "M-6 inntaksartefakt (m6-inntak-v1)",
  "comment": "M-6 inntak, de ti punktene (PR 3). Hvert punkt er et par (forsok, brudd) - null brudd uten minst ett forsok er en port som aldri kjorte. Feltsettet er generert fra manifestskjema.M6_INNTAK_INVARIANTER, aldri for haand; grensene staar i KRAVGRENSER.",
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt",
    "funn"
  ],
  "properties": {
    "krav_id": {
      "const": "m6-inntak-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "commit",
        "vert",
        "tenant"
      ],
      "properties": {
        "modul": {
          "const": "m06_epost"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string"
        },
        "notat": {
          "type": "string"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "innhenting_duplikatmelding_forsok",
        "innhenting_duplikatmelding_brudd",
        "persondata_i_klartekst_i_basen_forsok",
        "persondata_i_klartekst_i_basen_brudd",
        "kilde_credentials_ukryptert_forsok",
        "kilde_credentials_ukryptert_brudd",
        "logg_med_persondata_forsok",
        "logg_med_persondata_brudd",
        "kill_switch_konsumerte_kilder_forsok",
        "kill_switch_konsumerte_kilder_brudd",
        "deaktivert_kilde_hentet_forsok",
        "deaktivert_kilde_hentet_brudd",
        "autfeil_uten_feilet_kilde_forsok",
        "autfeil_uten_feilet_kilde_brudd",
        "forbigaende_feil_konsumerte_kilden_forsok",
        "forbigaende_feil_konsumerte_kilden_brudd",
        "slettet_melding_med_tekst_forsok",
        "slettet_melding_med_tekst_brudd",
        "modul_sendevei_finnes_forsok",
        "modul_sendevei_finnes_brudd",
        "rundtur_paa_disponit_com"
      ],
      "properties": {
        "innhenting_duplikatmelding_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "innhenting_duplikatmelding_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "persondata_i_klartekst_i_basen_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "persondata_i_klartekst_i_basen_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "kilde_credentials_ukryptert_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "kilde_credentials_ukryptert_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "logg_med_persondata_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "logg_med_persondata_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_konsumerte_kilder_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "kill_switch_konsumerte_kilder_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "deaktivert_kilde_hentet_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "deaktivert_kilde_hentet_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "autfeil_uten_feilet_kilde_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "autfeil_uten_feilet_kilde_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "forbigaende_feil_konsumerte_kilden_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "forbigaende_feil_konsumerte_kilden_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "slettet_melding_med_tekst_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "slettet_melding_med_tekst_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "modul_sendevei_finnes_forsok": {
          "type": "integer",
          "minimum": 0
        },
        "modul_sendevei_finnes_brudd": {
          "type": "integer",
          "minimum": 0
        },
        "rundtur_paa_disponit_com": {
          "type": "boolean",
          "description": "Bevisrunden gikk mot disponit.com med et EKTE oppdrag gjennom modulen (ikke stub-SMTP) - kvitteringen staar i basen."
        }
      }
    },
    "funn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alvor",
          "tekstnokkel"
        ],
        "properties": {
          "alvor": {
            "enum": [
              "rodt",
              "gult"
            ]
          },
          "tekstnokkel": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "detalj": {
            "type": "object"
          }
        }
      },
      "description": "Funnene som tekstnokler + parametre (aldri fritekst-PII)."
    }
  }
}
