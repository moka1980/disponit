{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-m38-ytelse-v1.json",
  "title": "m38-ytelse-v1 — claim under kølast og memoiseringens treffrate (ADR-005)",
  "comment": "Produsert av deploy/staging/m38-lest.py. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_m38_*.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "const": "m38-ytelse-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "bevisrot_sha256",
        "modul",
        "runde",
        "vert"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "runde": {
          "type": "string",
          "minLength": 1
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_lesinger",
        "cache_valideringer",
        "claimet",
        "feilede",
        "kall",
        "koelengde",
        "maks_ms",
        "ms",
        "p95_ms",
        "treffrate"
      ],
      "properties": {
        "kall": {
          "type": "integer"
        },
        "feilede": {
          "type": "integer"
        },
        "claimet": {
          "type": "integer"
        },
        "koelengde": {
          "type": "integer"
        },
        "p95_ms": {
          "type": "number"
        },
        "maks_ms": {
          "type": "number"
        },
        "ms": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cache_lesinger": {
          "type": "integer"
        },
        "cache_valideringer": {
          "type": "integer"
        },
        "treffrate": {
          "type": "number"
        }
      }
    }
  }
}
