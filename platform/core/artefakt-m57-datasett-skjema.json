{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-m57-datasett-v1.json",
  "title": "m57-datasett-v1 — syntetisk datasett likt lokalt (M-02s fordelingsform)",
  "comment": "Produsert av deploy/staging/m57-datasett-artefakt.py. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_m57_datasett, som re-regner den lokale digesten og re-summerer per_golden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "type": "string",
      "const": "m57-datasett-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "vert",
        "tenant",
        "oppdrag_id",
        "datasett_fil",
        "resultat",
        "bevisrot_sha256"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "const": "m57_ats"
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "oppdrag_id": {
          "type": "integer",
          "minimum": 1
        },
        "datasett_fil": {
          "type": "string",
          "minLength": 1
        },
        "resultat": {
          "type": "string",
          "minLength": 1
        },
        "forste_claim_ts": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_ts": {
          "type": [
            "string",
            "null"
          ]
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bunt_soknader",
        "fasitavvik",
        "umatchet",
        "datasett_sha_lokal",
        "datasett_sha_staging",
        "per_golden"
      ],
      "properties": {
        "bunt_soknader": {
          "type": "integer",
          "minimum": 0
        },
        "fasitavvik": {
          "type": "integer",
          "minimum": 0
        },
        "umatchet": {
          "type": "integer",
          "minimum": 0
        },
        "datasett_sha_lokal": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "datasett_sha_staging": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "per_golden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "golden_id",
              "antall",
              "forventet",
              "dommer",
              "avvik"
            ],
            "properties": {
              "golden_id": {
                "type": "string",
                "minLength": 1
              },
              "antall": {
                "type": "integer",
                "minimum": 0
              },
              "forventet": {
                "type": "object"
              },
              "dommer": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "avvik": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
