{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-m21-rollback-v1.json",
  "title": "m21-rollback-v1 — forgjengerens og kandidatens sender gir like ankre, og ingen dobbeltvarsel over rullingen (ADR-003 D3)",
  "comment": "Produsert av deploy/staging/forpass-lest.py. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_forpass_*.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "maalt"
  ],
  "properties": {
    "krav_id": {
      "const": "m21-rollback-v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "bevisrot_sha256",
        "forgjenger",
        "kjerne_forgjenger",
        "kjerne_kandidat",
        "modul",
        "modul_forgjenger",
        "modul_kandidat",
        "runde",
        "vert"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "runde": {
          "type": "string",
          "minLength": 1
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forgjenger": {
          "type": "string"
        },
        "kjerne_forgjenger": {
          "type": "string"
        },
        "kjerne_kandidat": {
          "type": "string"
        },
        "modul_forgjenger": {
          "type": "string"
        },
        "modul_kandidat": {
          "type": "string"
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ankre_forgjenger",
        "ankre_kandidat",
        "ankre_lik_fasit",
        "ankre_like",
        "forpass_feil",
        "kandidat_etter_rullbakk_nye"
      ],
      "properties": {
        "ankre_forgjenger": {
          "type": "object"
        },
        "ankre_kandidat": {
          "type": "object"
        },
        "ankre_like": {
          "type": "boolean"
        },
        "ankre_lik_fasit": {
          "type": "boolean"
        },
        "kandidat_etter_rullbakk_nye": {
          "type": "integer"
        },
        "forpass_feil": {
          "type": "array"
        }
      }
    }
  }
}
