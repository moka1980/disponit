{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disponit.no/skjema/artefakt-sveip-rollback-v1.json",
  "title": "<modul>-rollback-v1 — kjerneformen for en sveipmodul uten egen release",
  "comment": "Produsert av deploy/staging/rollback-sveipkjerne.py. Avbruddet tas utenfra (ACCESS EXCLUSIVE + SIGKILL), hver kjøring er en underprosess per release-katalog, og runneren bevitner hvilken fil sveipen ble lastet fra. `bestatt` er produsentens påstand; porten er manifestskjema._grenser_sveip_rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "krav_id",
    "ts",
    "bestatt",
    "oppsett",
    "identiteter",
    "maalt",
    "etterkontroll"
  ],
  "properties": {
    "krav_id": {
      "type": "string",
      "pattern": "^m[0-9]+-rollback-v1$"
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "bestatt": {
      "type": "boolean"
    },
    "feil": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oppsett": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modul",
        "miljo",
        "vert",
        "runde",
        "tenanter",
        "funntabell",
        "maalerolle",
        "drillet_release",
        "forgjenger_release",
        "drillet_katalog",
        "forgjenger_katalog",
        "drillet_digest",
        "forgjenger_digest",
        "drillet_kjernedigest",
        "forgjenger_kjernedigest",
        "arbeidernokkel",
        "bevisrot_sha256",
        "form"
      ],
      "properties": {
        "modul": {
          "type": "string",
          "minLength": 1
        },
        "miljo": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "type": "string",
          "minLength": 1
        },
        "runde": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "tenanter": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "funntabell": {
          "type": "string",
          "minLength": 1
        },
        "maalerolle": {
          "type": "string",
          "minLength": 1
        },
        "drillet_release": {
          "type": "string",
          "minLength": 1
        },
        "forgjenger_release": {
          "type": "string",
          "minLength": 1
        },
        "drillet_katalog": {
          "type": "string",
          "minLength": 1
        },
        "forgjenger_katalog": {
          "type": "string",
          "minLength": 1
        },
        "drillet_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forgjenger_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arbeidernokkel": {
          "type": "integer"
        },
        "bevisrot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "form": {
          "type": "string",
          "minLength": 1
        },
        "drillet_kjernedigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forgjenger_kjernedigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "identiteter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avbrutt_pid",
        "rullback_pid",
        "kandidat_pid",
        "avbrutt_fil",
        "rullback_fil",
        "kandidat_fil"
      ],
      "properties": {
        "avbrutt_pid": {
          "type": "integer"
        },
        "rullback_pid": {
          "type": "integer"
        },
        "kandidat_pid": {
          "type": "integer"
        },
        "avbrutt_fil": {
          "type": "string",
          "minLength": 1
        },
        "rullback_fil": {
          "type": "string",
          "minLength": 1
        },
        "kandidat_fil": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "maalt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inflight_drept",
        "inflight_returkode",
        "inflight_blokkerte_paa_laas",
        "inflight_funn",
        "arbeidernokkel_fri",
        "rullbakk_funn",
        "rullbakk_rader",
        "dubletter",
        "kandidat_nye",
        "kandidat_apne",
        "rullback_bytes_er_forgjengerens",
        "kandidat_bytes_er_drillede",
        "release_digest_bundet",
        "modul_digest_likt"
      ],
      "properties": {
        "inflight_drept": {
          "type": "boolean"
        },
        "inflight_returkode": {
          "type": "integer"
        },
        "inflight_blokkerte_paa_laas": {
          "type": "boolean"
        },
        "inflight_funn": {
          "type": "integer",
          "minimum": 0
        },
        "arbeidernokkel_fri": {
          "type": "boolean"
        },
        "rullbakk_funn": {
          "type": "integer",
          "minimum": 0
        },
        "rullbakk_rader": {
          "type": "integer",
          "minimum": 0
        },
        "dubletter": {
          "type": "integer",
          "minimum": 0
        },
        "kandidat_nye": {
          "type": "integer"
        },
        "kandidat_apne": {
          "type": "integer",
          "minimum": 0
        },
        "rullback_bytes_er_forgjengerens": {
          "type": "boolean"
        },
        "kandidat_bytes_er_drillede": {
          "type": "boolean"
        },
        "release_digest_bundet": {
          "type": "boolean"
        },
        "modul_digest_likt": {
          "type": "boolean"
        }
      }
    },
    "etterkontroll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aktiv_urort",
        "kandidat_feilet"
      ],
      "properties": {
        "aktiv_urort": {
          "type": "boolean"
        },
        "kandidat_feilet": {
          "type": "boolean"
        }
      }
    }
  }
}
