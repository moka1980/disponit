{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disponit policy-skjema v0.2",
  "description": "Formelt skjema (ChatGPT-review PR-001, funn B). additionalProperties: false overalt — ukjente felter avvises.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "tidssone", "roller", "dataklasser", "verifikatorer", "handlinger", "unntak"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "versjon", "bransjemal", "status"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 3, "pattern": "^[a-z0-9-]+$"},
        "versjon": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "bedrift": {"type": "string"},
        "bransjemal": {"type": "string", "minLength": 3},
        "kilder": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["utkast", "validert_pilot", "produksjon"]},
        "sist_endret": {"type": "string"},
        "endret_av": {"type": "string"}
      }
    },
    "tidssone": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z]+/[A-Za-z_+-]+$"},
    "roller": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                       "beskrivelse": {"type": "string"}}
      }
    },
    "dataklasser": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "verifikatorer": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"type": "string", "pattern": "^[^.\\[]+$",
                        "description": "Codex P2 (PR-013/#61): verifikator-id-en er den ENESTE frie nøkkelen i en ellers lukket policy, og den havner UTOLKET i diffstien `verifikatorer.<id>.<felt>` (`policydiff._flat`). Punktum og klammer er skilletegnene i den stien, så en id som inneholder dem gjør stien flertydig: med id-ene `foo` og `foo.beskrivelse` er `verifikatorer.foo.beskrivelse` både beskrivelsen til `foo` og roten til den andre verifikatoren, og godkjenneren kan da tilskrive en tillitsendring FEIL verifikator. Skilletegnene forbys derfor i id-en i stedet for å gjettes ut av stien i etterkant. Bevisst minimal: bare de to tegnene som skaper flertydigheten, ikke husmønsteret `^[a-z0-9_]+$`, så eksisterende id-er som allerede gir en entydig diff fortsatt validerer."},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["betrodd_for"],
        "properties": {
          "beskrivelse": {"type": "string"},
          "betrodd_for": {"type": "array", "minItems": 1,
                          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
          "kan_fastsla_permanent": {"type": "boolean",
                                    "description": "PR-007 / Scope v2 pkt. 5: retten til å erklære et vilkår PRINSIPIELT uinnhentbart. `betrodd_for` alene er ikke nok — en verifikator som kan attestere et vilkår er ikke dermed betrodd for å erklære det uoppnåelig. Uten denne behandles `permanent` som en forbigående negativ."}
        }
      }
    },
    "verifikator_prioritet": {
      "type": "object",
      "description": "PR-007 / Scope v2 pkt. 1: prioritet mellom verifikatorer som ALLE dekker settet. Lavest tall vinner; lik prioritet avgjøres av laveste verifikator_id, så ordningen er total og aldri avhengig av databaseorden.",
      "propertyNames": {"type": "string", "pattern": "^[^.\\[]+$",
                        "description": "Samme entydighetskrav som `verifikatorer`: nøkkelen er en verifikator-id og havner utolket i diffstien `verifikator_prioritet.<id>`."},
      "additionalProperties": {"type": "integer"}
    },
    "handlinger": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/handling"}
    },
    "frister": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kilde", "frekvens"],
        "properties": {"id": {"type": "string"}, "kilde": {"type": "string"},
                       "frekvens": {"type": "string"},
                       "varsling_dager_for": {"type": "array", "items": {"type": "integer", "minimum": 0}}}
      }
    },
    "retention": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["dataklasse"],
        "properties": {"dataklasse": {"type": "string"},
                       "aar_min": {"type": "integer", "minimum": 0},
                       "regel": {"type": "string"}, "sletting": {"type": "string"}}
      }
    },
    "unntak": {
      "type": "object", "additionalProperties": false,
      "required": ["kategorier", "maks_auto_forsok", "eskalering"],
      "properties": {
        "kategorier": {"type": "array", "minItems": 1,
                       "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "maks_auto_forsok": {"type": "integer", "minimum": 0, "maximum": 10},
        "eskalering": {"const": "unntakskø"}
      }
    },
    "menneskelig_overstyring": {
      "type": "object", "additionalProperties": false,
      "required": ["godkjennbare", "krever_rolle"],
      "properties": {
        "godkjennbare": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["grunnkode", "handling"],
            "dependentRequired": {"belop_maks": ["valuta"]},
            "properties": {
              "grunnkode": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "handling": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
              "belop_maks": {"type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$"},
              "valuta": {"type": "string", "pattern": "^[A-Z]{3}$"}
            }
          }
        },
        "krever_rolle": {"type": "string"},
        "krever_fire_oyne": {"type": "boolean"},
        "begrunnelse_pakrevd": {"type": "boolean"}
      }
    },
    "metadata": {
      "type": "object",
      "description": "Semantikkfrie visningsfelt (koder, beskrivelser, notater). FJERNES før policyen når motoren (v4 §4); nøytraliteten er STRUKTURELL, ikke grep-bevist. Alt under metadata klassifiseres som NØYTRAL.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "handling": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "modul", "modus", "ved_brudd", "reversering"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
        "modul": {"type": "string", "pattern": "^M-\\d{1,2}$"},
        "modus": {"enum": ["auto", "auto_med_vilkaar", "alltid_stopp"]},
        "ved_brudd": {"enum": ["unntakskø", "stopp_og_varsle", "frys"]},
        "tillatt_for": {"type": "array", "minItems": 1,
                        "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "dataklasser_tillatt": {"type": "array", "minItems": 1,
                                "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "maks_attestasjon_alder_s": {"type": "integer", "minimum": 1,
                                     "description": "PR-007 / v7 pkt. 1: tak på hvor gammel en attestasjon kan være for DENNE handlingen, uavhengig av verifikatorens eget `utloper`. Fravær = kun `utloper` gjelder."},
        "grenser": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "belop_maks": {"type": ["number", "string"],
                           "pattern": "^\\d+(\\.\\d{1,2})?$", "minimum": 0},
            "valuta": {"type": "array", "minItems": 1,
                       "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
            "tidsvindu": {"type": "string",
                          "pattern": "^(man|tir|ons|tor|fre|lor|son)-(man|tir|ons|tor|fre|lor|son) ([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"},
            "frekvens": {
              "type": "object", "additionalProperties": false,
              "required": ["maks", "periode_antall", "periode_enhet", "grupperingsnokkel"],
              "properties": {
                "maks": {"type": "integer", "minimum": 1},
                "periode_antall": {"type": "integer", "minimum": 1},
                "periode_enhet": {"enum": ["minutter", "timer", "dager", "uker"]},
                "grupperingsnokkel": {"type": "string", "pattern": "^[a-z0-9_]+$"}
              }
            }
          }
        },
        "vilkaar": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["navn", "verifikator"],
            "properties": {
              "navn": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "verifikator": {"type": "string"},
              "min": {"type": "number"}
            }
          }
        },
        "reversering": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"enum": ["direkte", "kompenserende", "irreversibel"]},
            "frist_sekunder": {"type": "integer", "minimum": 0},
            "handling": {"type": "string"}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "kompenserende"}}},
             "then": {"required": ["type", "handling"]}}
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"modus": {"enum": ["auto", "auto_med_vilkaar"]}}},
         "then": {"required": ["id", "modul", "modus", "ved_brudd", "reversering",
                               "tillatt_for", "dataklasser_tillatt"]}},
        {"if": {"properties": {"reversering": {"properties": {"type": {"const": "irreversibel"}}}},
                "required": ["reversering"]},
         "then": {"anyOf": [{"required": ["grenser"]}, {"required": ["vilkaar"]}]}}
      ]
    }
  }
}
